rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /globalTerritorySnapshots/{snapshotId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}
